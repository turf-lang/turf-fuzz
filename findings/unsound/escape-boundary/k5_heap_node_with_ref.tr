struct N { val: int, next: &?N }
struct H { k: int, head: &?N, own: &N }
error E1 { P(r: &N), Q }
fn clobber(d: int): int {
    mut buf: int[64];
    buf[0] = 0;
    mut i: int = 0;
    while i < 64 { buf[i] = 7777 + i; i = i + 1; }
    if d > 0 { return clobber(d - 1) + buf[d]; }
    return buf[5];
}
fn f(): &N { mut n: N = N::default(); n.val = 42; mut m: N = N::default(); m.next = &n; return heap(m); }
fn main(): int {
    mut p: &N = f(); mut q: &?N = p.next;
    clobber(3); if (q != null) { io::printline(q.val); }
    return 0;
}
