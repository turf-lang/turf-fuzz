import io;
import list::List;
import map::Map;
import stack::Stack;
import queue::Queue;
import set::Set;
struct N { val: int, next: &?N }
struct H { k: int, head: &?N, own: &N }
error E1 { P(r: &N), Q }
fn clobber(d: int): int {
    mut buf: int[64];
    buf[0] = 0;
    mut i: int = 0;
    while i < 64 { buf[i] = 7777 + i; i = i + 1; }
    if d > 0 { return clobber(d - 1) + buf[d]; }
    return buf[5];
}
fn f(c: int): &N { mut a: N = N::default(); a.val = 42; mut b: N = N::default(); b.val = 43; return (c > 0 give &a otherwise &b); }
fn main(): int {
    mut r: &N = f(1);
    clobber(3); io::printline(r.val);
    return 0;
}
